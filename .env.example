APP_HOST=127.0.0.1
APP_PORT=8000

OPENLCA_HOST=localhost
OPENLCA_PORT=8080
OPENLCA_CALCULATION_TIMEOUT_SECONDS=600
# Reusing product systems is the safe default. Set true only when intentional.
OPENLCA_RECREATE_PRODUCT_SYSTEMS=false
OPENLCA_SHOW_TOP_FLOWS=true

# Maximum raw XLSX upload size (25 MiB by default).
BOM_MAX_UPLOAD_BYTES=26214400

LLAMA_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
LLAMA_ALLOW_MPS=true
# Set true to prohibit Hugging Face downloads and use only cached model files.
LLAMA_LOCAL_FILES_ONLY=false
LLAMA_MAX_NEW_TOKENS=512
